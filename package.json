{
  "name": "chhath-mahaparv",
  "version": "1.0.0",
  "private": true,
  "description": "छठ महापर्व — an immersive 2D + 3D bilingual storytelling website about the four days of Chhath Puja",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "typecheck": "tsc --noEmit",
    "check:content": "node --experimental-strip-types --no-warnings scripts/check-content.mjs",
    "check:models": "node scripts/check-models.mjs",
    "models:optimize": "node scripts/optimize-models.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "gsap": "^3.12.5",
    "lucide-react": "^0.469.0",
    "next": "~15.1.9",
    "react": "~19.0.1",
    "react-dom": "~19.0.1",
    "three": "^0.172.0",
    "three-stdlib": "^2.35.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.172.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": "22.x"
  }
}
